{
  "name": "selenium-ai-agent",
  "version": "3.4.2",
  "description": "Selenium MCP server for AI test automation: planner, generator and healer agents; Python (pytest) by default, multi-language test generation (Java, C#, JS/TS, Robot Framework); Selenium Grid. For Claude Desktop, Claude Code, VS Code and Cursor.",
  "mcpName": "io.github.learn-automated-testing/selenium-ai-agent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "selenium-ai-agent": "./dist/bin/cli.js",
    "selenium-mcp": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/bin/cli.js",
    "clean": "rm -rf dist",
    "test": "mocha",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "selenium",
    "selenium-grid",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "browser-automation",
    "ai",
    "agent",
    "automation",
    "testing",
    "webdriver",
    "llm",
    "gpt",
    "accessibility",
    "test-automation",
    "ai-agents",
    "ai-testing",
    "playwright-alternative",
    "web-testing",
    "test-generator",
    "test-healer",
    "self-healing",
    "claude",
    "claude-desktop",
    "cursor",
    "cline",
    "selenium-mcp",
    "ai-agent",
    "pytest",
    "python",
    "playwright",
    "claude-code",
    "vscode",
    "copilot",
    "test-agents",
    "test-planner",
    "shadow-dom"
  ],
  "author": "R. van der Horst",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/learn-automated-testing/selenium_agent.git",
    "directory": "selenium-mcp-server"
  },
  "homepage": "https://github.com/learn-automated-testing/selenium_agent#readme",
  "bugs": {
    "url": "https://github.com/learn-automated-testing/selenium_agent/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "agents/",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "selenium-webdriver": "^4.27.0",
    "yaml": "^2.8.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5",
      "brace-expansion": "^2.1.8"
    }
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/selenium-webdriver": "^4.1.0",
    "@types/sinon": "^21.0.1",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "sinon": "^22.0.0",
    "tsx": "^4.21.1",
    "typescript": "^5.7.0"
  }
}
